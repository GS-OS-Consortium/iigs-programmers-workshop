# new files inside the package.
/asmiigs
/linkiigs
/makebiniigs
/omfdiff
/omfdump
/reziigs

# Apple-derived test fixtures are NEVER committed. Tests that need them read
# the IIGS_FIXTURES environment variable and skip when it is unset.
/fixtures/
/testdata/apple/
